# Add this to the Caddyfile used by the world-news Caddy container,
# then reload: docker exec world-news-caddy-1 caddy reload --config /etc/caddy/Caddyfile
# "irish-weather" is the Docker container running this app on Caddy's network.
# Caddy gets the HTTPS certificate by itself.
weather.techx1.com {
    reverse_proxy irish-weather:3005
}
